# QuantaLens AI environment variables. Copy to the right place and fill in.
# Never commit real values. Placeholders only.

# ───────────── Python engine (apps/engine/.env locally; Render env vars in production) ─────────────
# Neon pooled connection string for the application role (read/write on app tables).
DATABASE_URL=
# Neon connection string for the READ-ONLY role used to run generated SQL (SELECT on schema qdata only).
ANALYTICS_DATABASE_URL=
# Random 32+ byte secret used to sign/derive session and CSRF values. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Fernet key for encrypting stored external DB credentials. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# OpenAI-compatible LLM endpoint. Example: https://generativelanguage.googleapis.com/v1beta/openai/
AI_BASE_URL=
AI_PROVIDER_API_KEY=
AI_MODEL=
# Comma-separated origins allowed to call the engine directly (the Vercel app URL).
ALLOWED_ORIGINS=http://localhost:3000
# development | production
APP_ENV=development
# Max upload size in megabytes.
MAX_UPLOAD_MB=50

# ───────────── Next.js app (apps/web/.env.local locally; Vercel project settings in production) ─────────────
# Public URL of the web app. Safe to expose.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side only. Base URL of the Python engine. NOT prefixed with NEXT_PUBLIC.
PYTHON_ANALYTICS_API_URL=http://localhost:8000
